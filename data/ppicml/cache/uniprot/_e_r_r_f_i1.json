{"entryType":"UniProtKB reviewed (Swiss-Prot)","primaryAccession":"Q9UJM3","secondaryAccessions":["B2RDX9","Q9NTG9","Q9UD05"],"uniProtkbId":"ERRFI_HUMAN","entryAudit":{"firstPublicDate":"2003-01-27","lastAnnotationUpdateDate":"2026-09-02","lastSequenceUpdateDate":"2000-05-01","entryVersion":178,"sequenceVersion":1},"annotationScore":5,"organism":{"scientificName":"Homo sapiens","commonName":"Human","taxonId":9606,"lineage":["Eukaryota","Metazoa","Chordata","Craniata","Vertebrata","Euteleostomi","Mammalia","Eutheria","Euarchontoglires","Primates","Haplorrhini","Catarrhini","Hominidae","Homo"]},"proteinExistence":"1: Evidence at protein level","proteinDescription":{"recommendedName":{"fullName":{"value":"ERBB receptor feedback inhibitor 1"}},"alternativeNames":[{"fullName":{"value":"Mitogen-inducible gene 6 protein"},"shortNames":[{"value":"MIG-6"}]}]},"genes":[{"geneName":{"value":"ERRFI1"},"synonyms":[{"value":"MIG6"}]}],"comments":[{"texts":[{"evidences":[{"evidenceCode":"ECO:0000250"}],"value":"Negative regulator of EGFR signaling in skin morphogenesis. Acts as a negative regulator for several EGFR family members, including ERBB2, ERBB3 and ERBB4. Inhibits EGFR catalytic activity by interfering with its dimerization. Inhibits autophosphorylation of EGFR, ERBB2 and ERBB4. Important for normal keratinocyte proliferation and differentiation. Plays a role in modulating the response to steroid hormones in the uterus. Required for normal response to progesterone in the uterus and for fertility. Mediates epithelial estrogen responses in the uterus by regulating ESR1 levels and activation. Important for regulation of endometrium cell proliferation. Important for normal prenatal and perinatal lung development (By similarity)"}],"commentType":"FUNCTION"},{"texts":[{"evidences":[{"evidenceCode":"ECO:0000250"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"18046415"}],"value":"Interacts with ERBB2 (By similarity). Interacts with EGFR"}],"commentType":"SUBUNIT"},{"comme